      "name": "2. SQL Injection Attacks (BLOCKED -> 403)",
      "item": [
        {
          "name": "2.1 SQLi - Boolean Tautology Bypass (' OR 1=1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search?q=' OR 1=1--",
              "host": ["{{base_url}}"],
              "path": ["search"],
              "query": [
                {
                  "key": "q",
                  "value": "' OR 1=1--"
                }
              ]
            }
          }
        },
        {
          "name": "2.2 SQLi - UNION SELECT Data Extraction",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search?q=' UNION SELECT null, username, password FROM users--",
              "host": ["{{base_url}}"],
              "path": ["search"],
              "query": [
                {
                  "key": "q",
                  "value": "' UNION SELECT null, username, password FROM users--"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 SQLi - Destructive DROP TABLE in POST Body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin'; DROP TABLE users--",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        }
      ]
